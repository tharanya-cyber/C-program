#include<stdio.h>
int main()
{
    int a,b,c;
    scanf("%d%d%d",&a,&b,&c);
    if(a>b)
    printf("a is greatest",a);
    else if (a>c)
    printf("a is greatest",a);
    else if(b>c)
    printf("b is greatest",b);
    else
    printf("c is greatest",c);
}


